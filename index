        // ================================================================
        // HELPER FUNCTIONS
        // ================================================================
        function getPlayerName(id) { const p = data.players.find(p => p.id === id); return p ? p.name : '未知'; }
        function getPlayerAvatar(id) { const p = data.players.find(p => p.id === id); return p && p.avatar ? p.avatar : null; }
        function getPlayerRecords(playerId) { return data.records.filter(r => r.playerId === playerId).sort((a, b) => a.date.localeCompare(b.date)); }
        function getTotalProfit(playerId) { return getPlayerRecords(playerId).reduce((sum, r) => sum + r.profit, 0); }
        function getPlayerGames(playerId) { return getPlayerRecords(playerId).length; }
        function getTotalSelfDraw(playerId) { return getPlayerRecords(playerId).reduce((sum, r) => sum + (r.selfDraw || 0), 0); }
        function getTotalDealIn(playerId) { return getPlayerRecords(playerId).reduce((sum, r) => sum + (r.dealIn || 0), 0); }
        function getPlayerProfitHistory(playerId) {
            const records = getPlayerRecords(playerId);
            let cumulative = 0;
            return records.map(r => { cumulative += r.profit; return { date: r.date, cumulative: cumulative }; });
        }
        function getAllDates() { const dates = new Set(); data.records.forEach(r => dates.add(r.date)); return Array.from(dates).sort(); }
        function getRating(profit) {
            if (profit >= 2000) return { label: '👑 皇上', class: 'rank-emperor' };
            if (profit >= 1000) return { label: '🤴 親王', class: 'rank-king' };
            if (profit >= 500) return { label: '🛡️ 公爵', class: 'rank-duke' };
            if (profit >= 200) return { label: '⚔️ 伯爵', class: 'rank-earl' };
            if (profit >= 0) return { label: '🐴 騎士', class: 'rank-knight' };
            if (profit >= -300) return { label: '🛠️ 隨從', class: 'rank-squire' };
            if (profit >= -800) return { label: '🌾 平民', class: 'rank-peasant' };
            return { label: '❄️ 冷宮', class: 'rank-exile' };
        }

        function getAvatarHtml(player, index) {
            if (player.avatar) {
                return `<img class="player-avatar" src="${player.avatar}" alt="${player.name}" style="width:30px;height:30px;">`;
            } else {
                const icons = ['fa-dragon','fa-tiger','fa-chess-queen','fa-user-ninja','fa-hat-wizard','fa-hand-sparkles','fa-crown','fa-star','fa-feather','fa-bolt'];
                const icon = icons[index % icons.length];
                return `<div class="player-avatar-placeholder" style="width:30px;height:30px;font-size:0.9rem;"><i class="fas ${icon}"></i></div>`;
            }
        }

        function getAvatarHtmlById(playerId, index) {
            const player = data.players.find(p => p.id === playerId);
            if (!player) return `<div class="player-avatar-placeholder" style="width:30px;height:30px;font-size:0.9rem;"><i class="fas fa-user"></i></div>`;
            return getAvatarHtml(player, index);
