                    select.appendChild(option);
                });
                if (currentValue && data.players.some(p => p.id == currentValue)) select.value = currentValue;
            });
            const chartSelect = document.getElementById('chartPlayerSelect');
            const chartValue = chartSelect.value;
            chartSelect.innerHTML = '<option value="all">📊 所有玩家比較</option>';
            data.players.forEach(p => {
                const option = document.createElement('option');
                option.value = p.id;
                option.textContent = `👤 ${p.name}` + (p.exiled ? ' 🚫' : '');
                chartSelect.appendChild(option);
            });
            if (chartValue && data.players.some(p => p.id == chartValue)) chartSelect.value = chartValue;
        }

        function renderHistory() {
            const container = document.getElementById('historyList');
            const sorted = [...data.records].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 20);
            container.innerHTML = '';
            if (sorted.length === 0) { container.innerHTML = '<p style="color: #5e4e4e; text-align: center;">武林史冊尚未有記載...</p>'; return; }
            sorted.forEach(r => {
                const div = document.createElement('div');
                div.className = 'history-item';
                const profitClass = r.profit >= 0 ? 'history-profit-positive' : 'history-profit-negative';
                const symbol = r.profit >= 0 ? '+' : '';
                div.innerHTML = `<div class="history-info"><span><strong>${getPlayerName(r.playerId)}</strong></span><span class="${profitClass}">${symbol}${r.profit}</span>${r.selfDraw > 0 ? `<span style="color:#4ecdc4;">🤚${r.selfDraw}</span>` : ''}${r.dealIn > 0 ? `<span style="color:#ff6b6b;">💣${r.dealIn}</span>` : ''}<span class="history-date">${r.date}</span></div><div class="history-actions"><button class="edit-btn" onclick="openEditModal(${r.id})"><i class="fas fa-edit"></i></button><button class="delete-btn" onclick="deleteRecord(${r.id})"><i class="fas fa-trash"></i></button></div>`;
                container.appendChild(div);
            });
        }

        function updateDate() {
            const now = new Date();
            const y = now.getFullYear();
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const d = String(now.getDate()).padStart(2, '0');
            document.getElementById('todayDate').textContent = `${y}-${m}-${d} ｜ 第 ${Math.ceil(now.getDate()/7)} 週`;
            if (!document.getElementById('recordDate').value) document.getElementById('recordDate').value = `${y}-${m}-${d}`;
            if (!document.getElementById('photoDate').value) document.getElementById('photoDate').value = `${y}-${m}-${d}`;
        }

        function updateExileStatus() {
            const statusDiv = document.getElementById('exileStatus');
            if (editingPlayerId) {
                const player = data.players.find(p => p.id === editingPlayerId);
                if (player) {
                    statusDiv.textContent = player.exiled ? '🚫 此雀聖已被打入冷宮' : '✅ 此雀聖仍在朝中';
                    document.getElementById('exileBtnText').textContent = player.exiled ? '召回返朝' : '打入冷宮';
                }
            }
        }

        // ================================================================
        // EDIT PLAYER FUNCTIONS
        // ================================================================

        function loadPlayerForEdit() {
            const select = document.getElementById('editPlayerSelect2');
            const id = parseInt(select.value);
            if (!id) { document.getElementById('editPlayerArea').style.display = 'none'; editingPlayerId = null; return; }
            const player = data.players.find(p => p.id === id);
            if (!player) return;
            editingPlayerId = id;
            document.getElementById('editPlayerArea').style.display = 'block';
            document.getElementById('editPlayerName2').value = player.name;
            document.getElementById('editAvatarPreview2').style.display = 'none';
            document.getElementById('editAvatarUpload2').value = '';
            tempEditAvatar = null;
            updateExileStatus();
        }

        document.getElementById('editAvatarUpload2').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(event) {
                tempEditAvatar = event.target.result;
                document.getElementById('editAvatarPreviewImg2').src = tempEditAvatar;
                document.getElementById('editAvatarPreview2').style.display = 'flex';
            };
            reader.readAsDataURL(file);
        });

        function updatePlayer() {
            if (!editingPlayerId) { showToast('⚠️ 請先揀選玩家'); return; }
            const player = data.players.find(p => p.id === editingPlayerId);
            if (!player) return;
            const newName = document.getElementById('editPlayerName2').value.trim();
            if (newName && newName !== player.name) {
                if (data.players.some(p => p.name === newName && p.id !== editingPlayerId)) { showToast('⚠️ 名稱已被使用'); return; }
                player.name = newName;
            }
            if (tempEditAvatar) { player.avatar = tempEditAvatar; tempEditAvatar = null; document.getElementById('editAvatarPreview2').style.display = 'none'; }
            player.updatedAt = Date.now();
            saveData(data, `✅ 已更新 ${player.name} 嘅資料`);
            renderAll();
            if (isFirebaseConnected) syncToFirebase(`📤 ${player.name} 嘅資料已同步到雲端`);
        }

        function toggleExile() {
            if (!editingPlayerId) { showToast('⚠️ 請先揀選玩家'); return; }
            const player = data.players.find(p => p.id === editingPlayerId);
            if (!player) return;
            player.exiled = !player.exiled;
            player.updatedAt = Date.now();
            const msg = player.exiled ? `❄️ ${player.name} 已被打入冷宮` : `👑 ${player.name} 已召回返朝`;
            saveData(data, msg);
            renderAll();
            updateExileStatus();
            if (isFirebaseConnected) syncToFirebase(`📤 ${player.name} 嘅狀態已同步到雲端`);
        }

        document.getElementById('avatarUpload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(event) {
                tempAvatar = event.target.result;
                document.getElementById('avatarPreviewImg').src = tempAvatar;
                document.getElementById('avatarPreview').style.display = 'flex';
            };
            reader.readAsDataURL(file);
        });

        // ================================================================
        // ACTION FUNCTIONS
        // ================================================================

        document.getElementById('addPlayerForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('newPlayerName').value.trim();
            if (!name) { showToast('⚠️ 請輸入雀聖之名'); return; }
            if (data.players.some(p => p.name === name)) { showToast('⚠️ 此雀聖已登錄紫禁之巔'); return; }
            const newPlayer = { id: data.nextPlayerId++, name: name, avatar: tempAvatar || '', exiled: false, updatedAt: Date.now(), selfDraw: 0, dealIn: 0 };
            data.players.push(newPlayer);
            saveData(data, `🏯 歡迎 ${name} 登錄紫禁之巔！`);
            renderAll();
            document.getElementById('newPlayerName').value = '';
            tempAvatar = null;
            document.getElementById('avatarPreview').style.display = 'none';
            document.getElementById('avatarPreviewImg').src = '';
            document.getElementById('avatarUpload').value = '';
            if (isFirebaseConnected) syncToFirebase(`📤 ${name} 已同步到雲端`);
        });

        document.getElementById('addRecordForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const playerId = parseInt(document.getElementById('playerSelect').value);
            const date = document.getElementById('recordDate').value;
            const profit = parseInt(document.getElementById('dailyProfit').value);
            const selfDraw = parseInt(document.getElementById('selfDraw').value) || 0;
            const dealIn = parseInt(document.getElementById('dealIn').value) || 0;
            if (!playerId) { showToast('⚠️ 請揀選雀聖'); return; }
            if (!date) { showToast('⚠️ 請揀選決戰之日'); return; }
            if (isNaN(profit)) { showToast('⚠️ 請輸入有效嘅盈虧數字'); return; }
            const player = data.players.find(p => p.id === playerId);
            if (player) { player.selfDraw = (player.selfDraw || 0) + selfDraw; player.dealIn = (player.dealIn || 0) + dealIn; }
            const newRecord = { id: data.nextRecordId++, playerId: playerId, date: date, profit: profit, selfDraw: selfDraw, dealIn: dealIn, updatedAt: Date.now() };
            data.records.push(newRecord);
            const msg = `⚔️ 已記載 ${getPlayerName(playerId)} 嘅戰績：${profit >= 0 ? '+' : ''}${profit}`;
            saveData(data, msg);
            document.getElementById('dailyProfit').value = '';
            document.getElementById('selfDraw').value = '0';
            document.getElementById('dealIn').value = '0';
            renderAll();
            if (profit > 0) triggerMoneyRain(3);
            if (isFirebaseConnected) syncToFirebase(`📤 ${getPlayerName(playerId)} 嘅戰績已同步到雲端`);
        });

        // ================================================================
        // EDIT & DELETE RECORDS
        // ================================================================

        function openEditModal(recordId) {
            const record = data.records.find(r => r.id === recordId);
            if (!record) return;
            document.getElementById('editRecordId').value = recordId;
            document.getElementById('editPlayerSelect').value = record.playerId;
            document.getElementById('editDate').value = record.date;
            document.getElementById('editProfit').value = record.profit;
            document.getElementById('editSelfDraw').value = record.selfDraw || 0;
            document.getElementById('editDealIn').value = record.dealIn || 0;
            document.getElementById('editModal').classList.add('active');
        }

        function closeEditModal() { document.getElementById('editModal').classList.remove('active'); }

        document.getElementById('editForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const recordId = parseInt(document.getElementById('editRecordId').value);
            const playerId = parseInt(document.getElementById('editPlayerSelect').value);
            const date = document.getElementById('editDate').value;
            const profit = parseInt(document.getElementById('editProfit').value);
            const selfDraw = parseInt(document.getElementById('editSelfDraw').value) || 0;
            const dealIn = parseInt(document.getElementById('editDealIn').value) || 0;
            if (!playerId) { showToast('⚠️ 請揀選雀聖'); return; }
            if (!date) { showToast('⚠️ 請揀選決戰之日'); return; }
            if (isNaN(profit)) { showToast('⚠️ 請輸入有效嘅盈虧數字'); return; }
            const record = data.records.find(r => r.id === recordId);
            if (record) {
                const oldPlayer = data.players.find(p => p.id === record.playerId);
                if (oldPlayer) { oldPlayer.selfDraw = Math.max(0, (oldPlayer.selfDraw || 0) - (record.selfDraw || 0)); oldPlayer.dealIn = Math.max(0, (oldPlayer.dealIn || 0) - (record.dealIn || 0)); }
                record.playerId = playerId;
                record.date = date;
                record.profit = profit;
                record.selfDraw = selfDraw;
                record.dealIn = dealIn;
                record.updatedAt = Date.now();
                const newPlayer = data.players.find(p => p.id === playerId);
                if (newPlayer) { newPlayer.selfDraw = (newPlayer.selfDraw || 0) + selfDraw; newPlayer.dealIn = (newPlayer.dealIn || 0) + dealIn; }
                saveData(data, '✅ 已更新戰績！');
                renderAll();
                closeEditModal();
                if (profit > 0) triggerMoneyRain(2);
                if (isFirebaseConnected) syncToFirebase('📤 戰績已同步到雲端');
            }
        });

        function deleteRecord(recordId) {
            if (!confirm('⚠️ 確定要刪除呢條記錄？')) return;
            const record = data.records.find(r => r.id === recordId);
            if (record) {
                const player = data.players.find(p => p.id === record.playerId);
                if (player) { player.selfDraw = Math.max(0, (player.selfDraw || 0) - (record.selfDraw || 0)); player.dealIn = Math.max(0, (player.dealIn || 0) - (record.dealIn || 0)); }
            }
            data.records = data.records.filter(r => r.id !== recordId);
            saveData(data, '🗑️ 記錄已刪除');
            renderAll();
            if (isFirebaseConnected) syncToFirebase('📤 刪除操作已同步到雲端');
        }

        // ================================================================
        // MANUAL EXPORT/IMPORT
        // ================================================================

        function exportData() {
            const dataStr = JSON.stringify(data, null, 2);
            const blob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `麻將數據_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('✅ 備份已下載！');
        }

        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (imported.players && imported.records) {
                        if (confirm('⚠️ 這會覆蓋所有數據，確定繼續？')) {
                            data = imported;
                            if (!data.photos) data.photos = [];
                            data.lastUpdated = Date.now();
                            localStorage.setItem('mahjongData', JSON.stringify(data));
                            renderAll();
                            showToast('✅ 數據還原成功！');
                            if (isFirebaseConnected) syncToFirebase('✅ 數據已同步到雲端！');
                        }
                    } else { showToast('❌ 檔案格式錯誤'); }
                } catch (error) { showToast('❌ 匯入失敗：' + error.message); }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        // ================================================================
        // MONEY RAIN
        // ================================================================

        function toggleMoneyRain() { moneyRainActive ? stopMoneyRain() : startMoneyRain(); }

        function startMoneyRain() {
            moneyRainActive = true;
            const btn = document.querySelector('.rain-toggle');
            if (btn) { btn.classList.add('active'); btn.innerHTML = '<i class="fas fa-stop"></i> 停止金錢雨'; }
            triggerMoneyRain(50);
        }

        function stopMoneyRain() {
            moneyRainActive = false;
            const btn = document.querySelector('.rain-toggle');
            if (btn) { btn.classList.remove('active'); btn.innerHTML = '<i class="fas fa-coins"></i> 金錢雨'; }
            if (rainInterval) { clearInterval(rainInterval); rainInterval = null; }
        }

        function triggerMoneyRain(count = 10) {
            const container = document.getElementById('moneyRainContainer');
            const coins = ['💰', '🪙', '💎', '✨'];
            for (let i = 0; i < count; i++) {
                setTimeout(() => {
                    const coin = document.createElement('div');
                    coin.className = 'coin';
                    coin.textContent = coins[Math.floor(Math.random() * coins.length)];
                    coin.style.left = Math.random() * 100 + '%';
                    coin.style.fontSize = (18 + Math.random() * 24) + 'px';
                    coin.style.animationDuration = (2 + Math.random() * 3) + 's';
                    coin.style.animationDelay = (Math.random() * 0.5) + 's';
                    container.appendChild(coin);
                    setTimeout(() => { if (coin.parentNode) coin.remove(); }, 5000);
                }, i * 100);
            }
            if (moneyRainActive) {
                if (rainInterval) clearInterval(rainInterval);
                rainInterval = setInterval(() => {
                    if (moneyRainActive) {
                        for (let i = 0; i < 3; i++) {
                            const coin = document.createElement('div');
                            coin.className = 'coin';
                            coin.textContent = coins[Math.floor(Math.random() * coins.length)];
                            coin.style.left = Math.random() * 100 + '%';
                            coin.style.fontSize = (18 + Math.random() * 24) + 'px';
                            coin.style.animationDuration = (2 + Math.random() * 3) + 's';
                            container.appendChild(coin);
                            setTimeout(() => { if (coin.parentNode) coin.remove(); }, 5000);
                        }
                    } else { clearInterval(rainInterval); rainInterval = null; }
                }, 800);
            }
        }

        document.getElementById('chartSection').addEventListener('click', function(e) {
            if (e.target.closest('.rain-toggle') || e.target.closest('select') || e.target.closest('.btn-time')) return;
            triggerMoneyRain(5);
        });

        // ================================================================
        // CLEAR ALL DATA
        // ================================================================

        function clearAllData() {
            if (confirm('⚠️ 確定要重置天下？紫禁之巔將回歸混沌！')) {
                data = getDefaultData();
                data.nextPlayerId = 5;
                data.nextRecordId = 6;
                data.lastUpdated = Date.now();
                localStorage.setItem('mahjongData', JSON.stringify(data));
                renderAll();
                showToast('🏯 天下已重置，群雄再起！');
                if (isFirebaseConnected) syncToFirebase('📤 重置操作已同步到雲端');
            }
        }

        // ================================================================
        // TOAST NOTIFICATION
        // ================================================================

        function showToast(message) {
            if (toastTimer) { clearTimeout(toastTimer); toastTimer = null; }
            const old = document.querySelector('.toast');
            if (old) old.remove();
            const toast = document.createElement('div');
            toast.className = 'toast';
            if (message.includes('衝突') || message.includes('其他裝置')) toast.classList.add('toast-conflict');
            toast.textContent = message;
            document.body.appendChild(toast);
            toastTimer = setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = '0.3s';
                setTimeout(() => { if (toast.parentNode) toast.remove(); toastTimer = null; }, 300);
            }, 4000);
        }

        // ================================================================
        // INIT
        // ================================================================

        window.onload = function() {
            console.log('🚀 網頁載入中...');
            console.log('📋 功能: 主頁 | 排行榜(一局暴富/傾家蕩產/自摸最多/出銃最多) | 相片分享');
            data = loadData();
            renderAll();
            initFirebase();
            console.log('📋 Firebase Config:', firebaseConfig);
            setTimeout(() => triggerMoneyRain(8), 500);
        };

        document.getElementById('chartPlayerSelect').addEventListener('change', function() { renderChart(); });
        document.getElementById('editModal').addEventListener('click', function(e) { if (e.target === this) closeEditModal(); });
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeEditModal(); });
    </script>
</body>
