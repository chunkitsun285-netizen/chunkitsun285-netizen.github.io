        // ================================================================
        // 🔥 FIREBASE FUNCTIONS
        // ================================================================
        function initFirebase() {
            try {
                if (firebaseApp) return;
                console.log('🔄 初始化 Firebase...');
                firebaseApp = firebase.initializeApp(firebaseConfig);
                firestore = firebase.firestore(firebaseApp);
                firestore.enableNetwork().then(() => console.log('✅ Firebase 網絡已啟用'));
                console.log('✅ Firebase 初始化成功');
            } catch (error) {
                console.error('❌ Firebase 初始化失敗:', error);
            }
        }

        function updateFirebaseStatus(status) {
            const el = document.getElementById('firebaseStatus');
            if (status === 'online') { el.className = 'sync-status online'; el.innerHTML = '<i class="fas fa-circle"></i> 已連線 ✅'; }
            else if (status === 'syncing') { el.className = 'sync-status syncing'; el.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 同步中...'; }
            else if (status === 'conflict') { el.className = 'sync-status conflict'; el.innerHTML = '<i class="fas fa-exclamation-triangle"></i> 有衝突！'; }
            else { el.className = 'sync-status offline'; el.innerHTML = '<i class="fas fa-circle"></i> 未連線 ❌'; }
        }

        async function connectFirebase() {
            console.log('🔄 開始連線 Firebase...');
            if (!firebaseApp) initFirebase();
            if (!firestore) { try { firestore = firebase.firestore(firebaseApp); } catch(e) { showToast('❌ Firestore 初始化失敗'); return; } }
            try {
                showToast('⏳ 正在連線 Firebase...');
                updateFirebaseStatus('syncing');
                await firestore.collection('test').doc('test').set({ message: '連線測試', time: Date.now() });
                const testDoc = await firestore.collection('test').doc('test').get();
                console.log('✅ 測試讀取成功:', testDoc.data());
                isFirebaseConnected = true;
                updateFirebaseStatus('online');
                document.getElementById('firebaseConnectBtn').style.display = 'none';
                document.getElementById('firebaseSyncBtn').style.display = 'inline-block';
                document.getElementById('firebaseLoadBtn').style.display = 'inline-block';
                showToast('✅ Firebase 連線成功！');
                listenForUpdates();
                await loadFromFirebase();
            } catch (error) {
                console.error('❌ Firebase 連線失敗:', error);
                showToast('❌ Firebase 連線失敗: ' + error.message);
                updateFirebaseStatus('offline');
                isFirebaseConnected = false;
            }
        }

        async function syncToFirebase(showToastMsg = '✅ 數據已同步（覆蓋雲端）') {
            if (!isFirebaseConnected || !firestore) { showToast('⚠️ 請先連線 Firebase'); return false; }
            if (isSyncing) { console.log('⏭️ 同步進行中，跳過'); return false; }
            try {
                isSyncing = true;
                updateFirebaseStatus('syncing');
                console.log('📤 開始強制覆蓋同步...');
                const uploadData = {
                    players: data.players,
                    records: data.records,
                    photos: data.photos || [],
                    nextPlayerId: data.nextPlayerId,
                    nextRecordId: data.nextRecordId,
                    lastUpdated: Date.now()
                };
                await firestore.collection('mahjong').doc('data').set(uploadData);
                data.lastUpdated = uploadData.lastUpdated;
                localStorage.setItem('mahjongData', JSON.stringify(data));
                updateFirebaseStatus('online');
                hasConflict = false;
                document.getElementById('firebaseConflictBtn').style.display = 'none';
                console.log('✅ 強制覆蓋同步成功！');
                showToast(showToastMsg);
                return true;
            } catch (error) {
                console.error('❌ 同步失敗:', error);
                showToast('❌ 同步失敗：' + error.message);
                updateFirebaseStatus('offline');
                return false;
            } finally { isSyncing = false; }
        }

        async function forceSync() {
            if (confirm('⚠️ 確定要用你嘅數據覆蓋雲端？其他裝置嘅數據將會被取代！')) {
                await syncToFirebase('✅ 已強制覆蓋雲端數據！');
            }
        }

        async function loadFromFirebase() {
            if (!isFirebaseConnected || !firestore) { showToast('⚠️ 請先連線 Firebase'); return; }
            try {
                updateFirebaseStatus('syncing');
                showToast('⏳ 正在載入雲端數據...');
                const doc = await firestore.collection('mahjong').doc('data').get();
                if (doc.exists) {
                    const remoteData = doc.data();
                    const localTime = data.lastUpdated || 0;
                    const remoteTime = remoteData.lastUpdated || 0;
                    if (remoteTime > localTime) {
                        showToast('⚠️ 雲端數據較新，請按「載入雲端數據」更新');
                        updateFirebaseStatus('conflict');
                        hasConflict = true;
                        document.getElementById('firebaseConflictBtn').style.display = 'inline-block';
                    } else {
                        showToast('📌 本地數據較新，請按「強制覆蓋雲端」上傳');
                        updateFirebaseStatus('online');
                    }
                } else {
                    showToast('📁 雲端無數據，請上傳本地數據');
                }
            } catch (error) {
                console.error('❌ 載入失敗:', error);
                showToast('❌ 載入失敗：' + error.message);
                updateFirebaseStatus('offline');
            }
        }

        async function resolveConflict() {
            if (!confirm('⚠️ 確定要載入雲端數據？你嘅本地修改將會被取代！')) return;
            try {
                updateFirebaseStatus('syncing');
                showToast('⏳ 正在載入雲端數據...');
                const doc = await firestore.collection('mahjong').doc('data').get();
                if (doc.exists) {
                    const remoteData = doc.data();
                    data.players = remoteData.players || [];
                    data.records = remoteData.records || [];
                    data.photos = remoteData.photos || [];
                    data.nextPlayerId = remoteData.nextPlayerId || 1;
                    data.nextRecordId = remoteData.nextRecordId || 1;
                    data.lastUpdated = remoteData.lastUpdated || Date.now();
                    localStorage.setItem('mahjongData', JSON.stringify(data));
                    renderAll();
                    hasConflict = false;
                    document.getElementById('firebaseConflictBtn').style.display = 'none';
                    updateFirebaseStatus('online');
                    showToast('✅ 已載入雲端數據！');
                }
            } catch (error) {
                console.error('❌ 載入失敗:', error);
                showToast('❌ 載入失敗：' + error.message);
            }
        }

        function listenForUpdates() {
            if (!isFirebaseConnected || !firestore) return;
            console.log('📡 開始監聽 Firebase 變化...');
            firestore.collection('mahjong').doc('data').onSnapshot((doc) => {
                if (doc.exists && !isSyncing) {
                    const remoteData = doc.data();
                    const localTime = data.lastUpdated || 0;
                    const remoteTime = remoteData.lastUpdated || 0;
                    if (remoteTime === localTime) return;
                    console.log('📡 檢測到其他裝置更新');
                    hasConflict = true;
                    document.getElementById('firebaseConflictBtn').style.display = 'inline-block';
                    updateFirebaseStatus('conflict');
                    showToast('⚠️ 有其他裝置更新咗數據！點擊「發現衝突」載入');
                }
            }, (error) => console.error('❌ 監聽失敗:', error));
        }
