        <!-- ============================================================ -->
        <!-- TAB 1: 主頁 -->
        <!-- ============================================================ -->
        <div id="tab-home" class="tab-content active">
            <!-- 紫禁龍虎榜 -->
            <div class="rank-section">
                <div class="section-title"><i class="fas fa-crown"></i> 紫禁龍虎榜 ｜ 累計盈虧</div>
