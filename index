        function setChartRange(range) {
            chartRange = range;
            document.querySelectorAll('.btn-time').forEach(btn => { btn.classList.toggle('active', btn.dataset.range === range); });
            renderChart();
        }

        function getFilteredDates(allDates) {
            if (chartRange === 'all') return allDates;
            const now = new Date();
            return allDates.filter(date => {
                const d = new Date(date);
                if (chartRange === 'week') { const weekAgo = new Date(now); weekAgo.setDate(now.getDate() - 7); return d >= weekAgo; }
                if (chartRange === 'month') { const monthAgo = new Date(now); monthAgo.setMonth(now.getMonth() - 1); return d >= monthAgo; }
                return true;
            });
        }

        function renderChart() {
            const ctx = document.getElementById('profitChart').getContext('2d');
            const selected = document.getElementById('chartPlayerSelect').value;
            if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
            if (data.records.length === 0 || data.players.length === 0) return;
            let allDates = getAllDates();
            allDates = getFilteredDates(allDates);
            if (allDates.length === 0) return;
            let datasets = [];
            const activePlayers = data.players.filter(p => !p.exiled);
            if (selected === 'all') {
                activePlayers.forEach((player, idx) => {
                    const history = getPlayerProfitHistory(player.id);
                    if (history.length === 0) return;
                    const profitMap = {};
                    history.forEach(h => { profitMap[h.date] = h.cumulative; });
                    const dataPoints = allDates.map(date => profitMap[date] || null);
                    if (dataPoints.some(d => d !== null)) {
                        datasets.push({ label: player.name, data: dataPoints, borderColor: getPlayerColor(idx), backgroundColor: getPlayerColor(idx) + '33', borderWidth: 3, pointBackgroundColor: getPlayerColor(idx), pointRadius: 4, tension: 0.3, fill: true, spanGaps: true });
                    }
                });
                if (datasets.length === 0) return;
            } else {
                const playerId = parseInt(selected);
                const player = data.players.find(p => p.id === playerId);
                if (!player) return;
                const history = getPlayerProfitHistory(playerId);
                if (history.length === 0) return;
                const idx = data.players.indexOf(player);
                datasets = [{ label: player.name, data: history.map(h => h.cumulative), borderColor: getPlayerColor(idx), backgroundColor: getPlayerColor(idx) + '33', borderWidth: 3, pointBackgroundColor: getPlayerColor(idx), pointBorderColor: '#b8860b', pointRadius: 5, tension: 0.3, fill: true }];
            }
            chartInstance = new Chart(ctx, { type: 'line', data: { labels: allDates, datasets: datasets }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#ece6e0', font: { size: 12, weight: 'bold' } } } }, scales: { x: { ticks: { color: '#8a7e7e', maxRotation: 45 }, grid: { color: 'rgba(255,255,255,0.05)' } }, y: { ticks: { color: '#8a7e7e' }, grid: { color: 'rgba(255,255,255,0.05)' } } } } });
        }

