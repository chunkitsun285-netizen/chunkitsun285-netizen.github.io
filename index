<body>
    <div id="moneyRainContainer"></div>
    <div class="container">

        <!-- ===== HEADER ===== -->
        <div class="header">
            <div class="logo">
                <h1>🏯 雀界紫禁之巔 <span class="subtitle"><i class="fas fa-crown"></i> 天下雀聖 · 唯我獨尊 <i class="fas fa-crown"></i></span></h1>
            </div>
