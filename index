        function loadData() {
            const stored = localStorage.getItem('mahjongData');
            if (stored) {
                try {
                    const parsed = JSON.parse(stored);
                    parsed.players.forEach(p => {
                        if (p.selfDraw === undefined) p.selfDraw = 0;
                        if (p.dealIn === undefined) p.dealIn = 0;
                    });
                    parsed.records.forEach(r => {
                        if (r.selfDraw === undefined) r.selfDraw = 0;
                        if (r.dealIn === undefined) r.dealIn = 0;
                    });
                    if (!parsed.photos) parsed.photos = [];
                    return parsed;
                } catch (e) {
                    return getDefaultData();
                }
            }
            return getDefaultData();
        }

        function saveData(data, showToastMsg = null) {
            data.lastUpdated = Date.now();
            localStorage.setItem('mahjongData', JSON.stringify(data));
            if (showToastMsg) showToast(showToastMsg);
        }

        function getDefaultData() {
            return {
                players: [
                    { id: 1, name: '龍爺', avatar: '', exiled: false, updatedAt: Date.now(), selfDraw: 0, dealIn: 0 },
